# 端口号
VITE_PORT=5777

VITE_BASE=/

# 接口地址
VITE_GLOB_API_URL=/api

# OAuth2 授权服务器（public client + PKCE）
VITE_GLOB_AUTH_URL=http://127.0.0.1:20005
VITE_GLOB_OAUTH_CLIENT_ID=web-spa
# 回调地址不写死：state/PKCE 暂存在 sessionStorage（按 origin 隔离），
# localhost 与 127.0.0.1 是两个不同的源，写死任一都会导致首次 SSO 报 state 校验失败。
# 代码默认取 window.location.origin + /oauth2/callback，授权服务器需注册该地址
# （V4 迁移已同时注册 http://127.0.0.1:5777 与 http://localhost:5777 两个回调）。
# VITE_GLOB_OAUTH_REDIRECT_URI=
VITE_GLOB_OAUTH_SCOPE=openid profile email

# 是否开启 Nitro Mock服务，true 为开启，false 为关闭
VITE_NITRO_MOCK=false

# 是否打开 devtools，true 为打开，false 为关闭
VITE_DEVTOOLS=false

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true
